<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.Views.LoginPage">

    <Grid RowDefinitions="Auto, *">
           
            <Frame Grid.Row="1" 
               VerticalOptions="Center" 
               HorizontalOptions="Center"
               WidthRequest="320"
               CornerRadius="20"
               HasShadow="True"
               BorderColor="LightGray"
               Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label x:Name="lblTitle" 
                       Text="Oturum Aç" 
                       FontSize="24" 
                       TextColor="#333" 
                       HorizontalOptions="Start"/>

                    <Entry x:Name="txtUsername"
                       Placeholder="Kullanıcı Adı"
                       IsVisible="False"
                       TextColor="Black"/>

                    <BoxView x:Name="lineUsername" 
                         HeightRequest="1" 
                         Color="Gray" 
                         IsVisible="False"/>

                    <Entry x:Name="txtEmail"
                       Placeholder="Email"
                       Keyboard="Email"
                       TextColor="Black"/>
                    <BoxView HeightRequest="1" Color="Gray"/>

                    <Entry x:Name="txtPassword"
                       Placeholder="Password"
                       IsPassword="True"
                       TextColor="Black"/>
                    <BoxView HeightRequest="1" Color="Gray"/>

                    <Button x:Name="btnAction"
                        Text="Oturum Aç"
                        BackgroundColor="#00aac3"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnActionClicked"/>

                    <ActivityIndicator x:Name="loadingIndicator"
                                   IsRunning="False"
                                   Color="#00aac3"/>

                    <Label x:Name="lblSwitch"
                       Text="Hesabım Yok"
                       TextColor="#00aac3"
                       HorizontalOptions="Center"
                       FontSize="16">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSwitchModeTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Frame>
        </Grid>












</ContentPage>