<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp3.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp3"
    xmlns:Views="clr-namespace:MauiApp3.Views"
    Shell.FlyoutBehavior="Flyout"
    >

    <FlyoutItem Title="AnaSayfa" Icon="{FontImage Glyph='🏠', Color='#2196F3', Size=25}">
        <ShellContent ContentTemplate="{DataTemplate  Views:AnaSayfa}" />
    </FlyoutItem>
    <FlyoutItem Title="Kurlar" Icon="{FontImage Glyph='💲', Color='#4CAF50', Size=25}">
        <ShellContent ContentTemplate="{DataTemplate Views:KurlarPage}" />
    </FlyoutItem>
    <FlyoutItem Title ="Haberler" Icon="{FontImage Glyph='📰', Color='#607D8B', Size=25}">
        <ShellContent ContentTemplate="{DataTemplate Views:HaberlerPage}" /> 
    </FlyoutItem>
    <FlyoutItem Title="Hava Durumu"  Icon="{FontImage Glyph='⛅', Color='#FFC107', Size=25}">
        <ShellContent ContentTemplate="{DataTemplate Views:HavaDurumuPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Yapılacaklar" Icon="{FontImage Glyph='✅', Color='#9C27B0', Size=25}">
        <ShellContent ContentTemplate="{DataTemplate Views:YapilacaklarPage}" /> 
    </FlyoutItem>
    <FlyoutItem Title="Ayarlar" Icon="{FontImage Glyph='⚙', Color='#757575', Size=25}">
        <ShellContent ContentTemplate="{DataTemplate Views:AyarlarPage}"/>
    </FlyoutItem>

</Shell>
